// Cloudflare deploys this repository to app.solepro.app (and the old sole.brookstelles.com while Kelli moves over).
// Only site/ is published; build_demo.py copies index.html there. The workers.dev and preview addresses stay off.
{
  "name": "sole",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./site" },
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "app.solepro.app", "custom_domain": true }, { "pattern": "sole.brookstelles.com", "custom_domain": true }]
}
